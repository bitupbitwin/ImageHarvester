{
  "manifest_version": 3,
  "name": "图片抓取器 · Image Grabber",
  "version": "1.0.0",
  "description": "仿照 Fatkun，一键抓取当前页面（含背景图、懒加载、iframe）的所有图片，支持缩略图预览、按尺寸/格式筛选、批量选择与下载。",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "抓取本页所有图片",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "grabber.html",
        "grabber.js",
        "grabber.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
